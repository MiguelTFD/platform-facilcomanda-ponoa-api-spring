# ==============================================================================
# FACILCOMANDA PONOA API - PLANTILLA DE VARIABLES DE ENTORNO (PRODUCCIÓN)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo como '.env.production' o '.env':
#      cp .env.production.example .env.production
# 2. Reemplaza todos los valores de ejemplo ("CHANGE_ME_...") con credenciales seguras.
# 3. NUNCA subas a Git tu archivo '.env.production' real con credenciales de producción.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICACIÓN Y PERFIL SPRING
# ------------------------------------------------------------------------------
# Perfil activo de Spring Boot (prod activa configuraciones óptimas y seguras)
SPRING_PROFILES_ACTIVE=prod
# Puerto interno donde escucha la API (por defecto 8081)
SERVER_PORT=8081

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (POSTGRESQL 15+)
# ------------------------------------------------------------------------------
# Host o IP del servidor PostgreSQL (o nombre del servicio docker 'postgres')
FCP_DB_HOST=postgres
# Puerto de conexión PostgreSQL
FCP_DB_PORT=5432
# Nombre de la base de datos de producción
FCP_DB_NAME=fcp_db_prod
# Usuario de base de datos con permisos DDL/DML para migraciones Flyway
FCP_DB_USER=fcp_app_user
# Contraseña fuerte para la base de datos (mínimo 16 caracteres alfanuméricos)
FCP_DB_PASSWORD=CHANGE_ME_SECURE_POSTGRES_PASSWORD_123!

# ------------------------------------------------------------------------------
# 3. MENSAJERÍA ASÍNCRONA (RABBITMQ 3.13+)
# ------------------------------------------------------------------------------
# Host del broker RabbitMQ (o nombre del servicio docker 'rabbitmq')
FCP_RABBIT_HOST=rabbitmq
# Puerto AMQP de RabbitMQ (5672)
FCP_RABBIT_PORT=5672
# Usuario de RabbitMQ para la API
FCP_RABBIT_USER=fcp_rabbit_user
# Contraseña de RabbitMQ
FCP_RABBIT_PASSWORD=CHANGE_ME_SECURE_RABBIT_PASSWORD_456!

# ------------------------------------------------------------------------------
# 4. AUTENTICACIÓN Y SEGURIDAD OIDC (KEYCLOAK)
# ------------------------------------------------------------------------------
# URI pública/privada del emisor de tokens JWT de Keycloak
# Formato: https://<auth-domain>/realms/<realm-name>
KEYCLOAK_ISSUER_URI=https://auth.facilcomanda.com/realms/fcp-realm

# Credenciales maestras de administración de Keycloak (usado solo si despliegas Keycloak vía docker-compose)
FCP_KC_ADMIN=admin_prod
FCP_KC_PASSWORD=CHANGE_ME_SECURE_KEYCLOAK_ADMIN_PASSWORD_789!

# ------------------------------------------------------------------------------
# 5. SEGURIDAD WEB Y CONTROL DE ACCESO (CORS)
# ------------------------------------------------------------------------------
# Dominios frontend autorizados separados por coma.
# IMPORTANTE EN PROD: NO USAR '*' ni 'null'. Especifica los orígenes HTTPS exactos.
# Ejemplo: https://app.facilcomanda.com,https://pos.facilcomanda.com,https://cocina.facilcomanda.com
CORS_ALLOWED_ORIGINS=https://app.facilcomanda.com,https://pos.facilcomanda.com

# ------------------------------------------------------------------------------
# 6. FACTURACIÓN ELECTRÓNICA (SUNAT / PROVEEDOR PSE)
# ------------------------------------------------------------------------------
# URL base de la API fiscal (ejemplo: MiApi, Nubefact, PSE autorizado)
TAX_API_BASE_URL=https://api.facturacion.sunat.gob.pe/v1
# Token Bearer de autenticación fiscal provisto por el PSE o servicio SUNAT
TAX_API_TOKEN=CHANGE_ME_TAX_API_BEARER_TOKEN_HERE

# ------------------------------------------------------------------------------
# 7. SERVICIO DE CORREO ELECTRÓNICO (SMTP)
# ------------------------------------------------------------------------------
# Host del servidor SMTP (ej. smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com)
FCP_SMTP_HOST=smtp.sendgrid.net
# Puerto SMTP (comúnmente 587 para TLS/STARTTLS o 465 para SSL)
FCP_SMTP_PORT=587
# Usuario o API Key de SMTP (ej. 'apikey' para SendGrid)
FCP_SMTP_USER=apikey
# Contraseña o Secret Key de SMTP
FCP_SMTP_PASSWORD=CHANGE_ME_SECURE_SMTP_API_KEY

# ------------------------------------------------------------------------------
# 8. CONFIGURACIONES DE RENDIMIENTO JVM (DOCKER CONTAINER)
# ------------------------------------------------------------------------------
# Opciones de memoria para la JVM dentro del contenedor Docker:
# -XX:+UseG1GC: Colector de basura de baja latencia recomendado para APIs Spring
# -XX:MaxRAMPercentage: Porcentaje de la RAM del contenedor a asignar al Heap (ej. 75%)
JAVA_TOOL_OPTIONS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -Duser.timezone=America/Lima -Dfile.encoding=UTF-8
